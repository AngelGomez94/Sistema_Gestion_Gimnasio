select * from configuracion

update configuracion
set costo_mantenimiento = '1'
where id = '1'

select u.nombre, u.apellidos, o.concepto , o.monto
from miembros u
inner join pagos o
on u.id = o.miembro_id

update miembros 
set estatus = 'Activo',
    fecha_registro = '2026-01-18',
    fecha_vencimiento = '2026-04-18'
where nombre = 'Valeria' and apellidos = 'Gomez'




delete from miembros where nombre = 'Andres' and apellidos = 'Mejia'

update pagos
set 
    fecha_hora = '2026-03-04 12:03:44'
where id = '3'

INSERT INTO miembros (
    nombre, 
    apellidos, 
    telefono, 
    telefono_emergencia, 
    email, 
    enfermedad, 
    detalles_enfermedad, 
    tipo_plan, 
    usa_locker, 
    fecha_registro, 
    fecha_vencimiento, 
    estatus, 
    ruta_foto, 
    anio_mantenimiento
) 
